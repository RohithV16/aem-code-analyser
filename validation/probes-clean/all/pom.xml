<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.probe</groupId><artifactId>analyser-probes</artifactId><version>1.0.0</version></parent>
  <artifactId>probe.all</artifactId><packaging>content-package</packaging>
  <build><plugins><plugin><groupId>org.apache.jackrabbit</groupId><artifactId>filevault-package-maven-plugin</artifactId>
    <configuration>
      <packageType>container</packageType>
      <embeddeds>
        <embedded>
          <groupId>com.probe</groupId>
          <artifactId>probe.ui.apps</artifactId>
          <type>zip</type>
          <target>/apps/probe-packages/application/install</target>
        </embedded>
        <embedded>
          <groupId>com.probe</groupId>
          <artifactId>probe.ui.config</artifactId>
          <type>zip</type>
          <target>/apps/probe-packages/application/install</target>
        </embedded>
        <embedded>
          <groupId>com.probe</groupId>
          <artifactId>probe.ui.content</artifactId>
          <type>zip</type>
          <target>/apps/probe-packages/content/install</target>
        </embedded>
        <embedded>
          <groupId>com.probe</groupId>
          <artifactId>probe.content.extra</artifactId>
          <type>zip</type>
          <target>/apps/probe-packages/content/install</target>
        </embedded>
        <!-- Clean twin of AEM-CLOUD-009: every embed lands under .../install. -->
        <embedded>
          <groupId>com.probe</groupId>
          <artifactId>probe.core</artifactId>
          <target>/apps/probe-packages/application/install</target>
        </embedded>
        <embedded>
          <groupId>com.probe</groupId>
          <artifactId>probe.zzprobe.content</artifactId>
          <type>zip</type>
          <target>/apps/probe-packages/content/install</target>
        </embedded>
      </embeddeds>
    </configuration>
  </plugin></plugins></build>
</project>
